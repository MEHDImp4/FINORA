{
  "expo": {
    "name": "FINORA",
    "slug": "finora",
    "scheme": "finora",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/finora-logo-text.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "icon": "./assets/finora-icon-f.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finora.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.finora.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/finora-icon-f.png",
        "backgroundColor": "#0A0A0C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-asset",
      "expo-splash-screen",
      "expo-brightness",
      [
        "expo-notifications",
        {
          "icon": "./assets/finora-icon-f.png",
          "color": "#E50914"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
