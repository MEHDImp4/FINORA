{
  "expo": {
    "name": "FINORA",
    "slug": "finora",
    "scheme": "finora",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/finora-logo-text.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finora.app"
    },
    "android": {
      "package": "com.finora.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-asset",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
